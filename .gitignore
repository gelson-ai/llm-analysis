# --- Python environment & caches ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Local run logs (run_weekly.bat output) ---
logs/

# --- Machine-local runtime locks (must never be committed) ---
# One lock file per pipeline: the chat refresh and the media refresh must never
# share one, or a stuck run in either would block the other. The wildcard also
# covers a future video pipeline's *_refresh.lock - without it, CI's
# `git add -A data` would happily commit a lock file.
data/analysis/.refresh.lock
data/analysis/.*_refresh.lock

# --- Secrets, editors, OS cruft ---
.env
.env.*
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
